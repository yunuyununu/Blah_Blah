<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.blah.mapper.JoinMapper">

    <insert id="userjoin">
		INSERT INTO USER (U_ID,U_PASSWORD,U_NICNAME,U_EMAIL,U_PHONE,U_FILE) 
		VALUES (#{u_id},#{u_password},#{u_nicname},#{u_email},#{u_tel},#{u_file})
        
    </insert>
    
    <!-- 아이디 중복체크 -->
	<select id="idCheck" resultType="int">
		SELECT count(*) FROM user
		WHERE U_ID = #{u_id}
	</select>
	
	<!--이메일 중복체크-->
	<select id="emailCheck" resultType="int">
		SELECT count(*) FROM user
		WHERE U_EMAIL = #{u_emial}
	</select>

</mapper>
