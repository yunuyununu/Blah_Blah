<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.blah.mapper.FileMapper">

	<!--다중 데이터 처리 => Bulk insert-->
	
	<!--image_file 테이블 전체 컬럼-->
	<sql id="fileColumns">
		i_idx,
		i_b_idx,
		i_image,
		i_date
	</sql>
	
	<!--게시글 첨부파일 저장-->
	<insert id="imageSave" parameterType="list">
		INSERT INTO image_file (
            <include refid="fileColumns" />
        ) VALUES
        <foreach item="file" collection="list" separator=",">
        (
              #{file.i_idx}
            , #{file.i_b_idx}
            , #{file.i_image}
            , NOW()
        )
        </foreach>
	</insert>
	
</mapper>
