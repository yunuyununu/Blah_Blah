<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.blah.mapper.CompanyMapper">
    <select id="list" resultType="com.example.blah.domain.CompanyDTO">
        SELECT C_IDX,		<!--회사번호-->
        	   C_NAME,		<!--회사명-->
        	   C_LOGO,		<!--회사대표사진-->
        	   C_INDUSTRY,	<!--회사업계-->
        	   C_EST,		<!--회사 설립일자-->
        	   C_INTRO,		<!--회사소개-->
        	   C_NUMBER,	<!--회사인원-->
        	   C_BUSINESS,	<!--사업자등록번호-->
        	   C_REGISTER	<!--등록일자-->
        FROM COMPANY
        
    </select>

</mapper>
